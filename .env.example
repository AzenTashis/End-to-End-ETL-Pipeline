# =============================================================================
# Copy this file to ".env" and change the passwords:
#     copy .env.example .env        (Windows Command Prompt / PowerShell)
# .env is listed in .gitignore, so your real passwords never reach GitHub.
# =============================================================================

# ---- PostgreSQL (used by Docker AND by Python on Windows) ----
POSTGRES_USER=etl_user
POSTGRES_PASSWORD=change_me_please
POSTGRES_HOST_PORT=5432

# ---- How Python on Windows reaches the sales database ----
SALES_DB_HOST=localhost
SALES_DB_PORT=5432
SALES_DB_NAME=sales_dw
SALES_DB_USER=etl_user
SALES_DB_PASSWORD=change_me_please

# ---- Product API ----
# Pipeline on Windows:
API_BASE_URL=https://dummyjson.com
# Pipeline inside Airflow (Docker). For the local mock API use http://host.docker.internal:8000
API_BASE_URL_DOCKER=https://dummyjson.com
API_TIMEOUT_SECONDS=10
API_MAX_RETRIES=3
API_PAGE_SIZE=50
API_USE_SNAPSHOT_FALLBACK=true
# DummyJSON prices are in USD; this rate converts them to INR.
API_PRICE_TO_INR=85

# ---- Airflow ----
AIRFLOW_VERSION=3.3.1
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_too
# Any long random text. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_JWT_SECRET=replace_with_a_long_random_string_1
AIRFLOW_API_SECRET_KEY=replace_with_a_long_random_string_2
# Optional encryption key for Airflow connections (can stay empty for local use)
AIRFLOW_FERNET_KEY=

LOG_LEVEL=INFO
